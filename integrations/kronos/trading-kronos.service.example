[Unit]
Description=Optional read-only Kronos CPU forecasting worker
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=tradingbot
Group=tradingbot
WorkingDirectory=/opt/trading-kronos
ExecStart=/opt/trading-kronos/.venv/bin/python -u /opt/trading-kronos/app/worker.py --runtime /opt/trading-kronos
Restart=on-failure
RestartSec=10
MemoryMax=1024M
CPUQuota=100%
TasksMax=32
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=HF_HOME=/tmp/kronos-hf
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1

[Install]
WantedBy=multi-user.target
