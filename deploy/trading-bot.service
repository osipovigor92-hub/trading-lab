[Unit]
Description=Bybit LINK grid PAPER simulator
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tradingbot
Group=tradingbot
WorkingDirectory=/opt/trading-bot
ExecStart=/usr/bin/python3 -u /opt/trading-bot/bot.py
Restart=on-failure
RestartSec=30
CPUQuota=20%
MemoryHigh=120M
MemoryMax=160M
TasksMax=16
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trading-bot
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
