[Unit]
Description=Bybit public market scanner, analysis only
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=tradingbot
Group=tradingbot
ExecStart=/usr/bin/python3 -u /opt/trading-scanner/scanner.py
TimeoutStartSec=10min
CPUQuota=15%
MemoryHigh=96M
MemoryMax=160M
TasksMax=8
Nice=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trading-scanner
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=PYTHONDONTWRITEBYTECODE=1
