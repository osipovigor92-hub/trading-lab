[Unit]
Description=Experimental scalp PAPER simulation only
Wants=trading-live.service
After=trading-live.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tradingbot
Group=tradingbot
ExecStart=/usr/bin/python3 -u /opt/scalp-paper/paper.py
Restart=on-failure
RestartSec=15
CPUQuota=10%
MemoryMax=80M
TasksMax=8
Nice=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scalp-paper
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
