[Unit]
Description=Read-only experimental orderbook signal analysis
Wants=trading-live.service
After=trading-live.service

[Service]
Type=simple
User=tradingbot
Group=tradingbot
ExecStart=/usr/bin/python3 -u /opt/trading-signals/signals.py
Restart=on-failure
RestartSec=10
CPUQuota=5%
MemoryMax=64M
TasksMax=8
Nice=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trading-signals
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
